@model LaKzaTCC.Models.Pedido

@{
    ViewData["Title"] = "Pedido Confirmado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

<div class="conteudo mt-5 text-center">
    <h2>Pedido Realizado com Sucesso!</h2>
    <p class="lead">Obrigado pela sua compra. Abaixo estão os detalhes:</p>

    <hr />

    <p><strong>Data do Pedido:</strong> @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Valor Unitário</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto.Nome</td>
                    <td>@item.Quantidade</td>
                    <td>R$ @item.ValorUnitario.ToString("F2")</td>
                    <td>R$ @((item.Quantidade * item.ValorUnitario).ToString("F2"))</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Botão WhatsApp -->
    <a id="btnWhatsApp" class="btn btn-success mt-3" target="_blank">
        Finalizar pelo WhatsApp
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const numeroLoja = "14998087834";

            const dataPedido = @Html.Raw(Json.Serialize(Model.DataPedido.ToString("dd/MM/yyyy HH:mm")));

            let itens = "";

            @foreach (var item in Model.Itens)
            {
                var produto = item.Produto.Nome;
                var quantidade = item.Quantidade;
                var valorUnitario = item.ValorUnitario.ToString("F2");
                var total = (item.Quantidade * item.ValorUnitario).ToString("F2");

                <text>
                    itens += " Produto: @produto\n";
                    itens += " Quantidade: @quantidade\n";
                    itens += " Valor Unitário: R$ @valorUnitario\n";
                    itens += " Total: R$ @total\n\n";
                </text>
            }

            const mensagem = ` *Novo Pedido Realizado!*\n\n🗓 Data do Pedido: ${dataPedido}\n\n${itens}✅ Pedido feito pelo site La Kza.`;

            const mensagemCodificada = encodeURIComponent(mensagem);

            const urlWhatsApp = `https://wa.me/${numeroLoja}?text=${mensagemCodificada}`;

            const botao = document.getElementById("btnWhatsApp");
            if (botao) {
                botao.href = urlWhatsApp;
            } else {
                console.warn("Botão #btnWhatsApp não encontrado.");
            }
        });
    </script>
}
