<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

@model List<LaKzaTCC.Models.Produto>
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css">
}

@{
    var categorias = ViewBag.Categorias as List<LaKzaTCC.Models.Categoria>;
    int? categoriaSelecionada = ViewBag.CategoriaSelecionada as int?;
}

@* Começo do Carrousel *@
<div id="carouselBanner" class="carousel carousel-dark slide">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="0" class="active" aria-current="true"
            aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="3" aria-label="Slide 4"></button>
    
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/car1.jpeg" class="d-block w-100" alt="...">
            <div class="carousel-caption">
                <h5>LaKza </h5>
                <p class=" d-none d-md-block">O aconchego do seu lar em nossas mãos </p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/img/car2.jpg" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>LaKza</h5>
                <p>O aconchego do seu lar em nossas mãos.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/img/car3.jpg" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>LaKza</h5>
                <p>O aconchego do seu lar em nossas mãos</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/img/car4.jpg" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>LaKza</h5>
                <p>O aconchego do seu lar em nossas mãos</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
@* Fim do Carousel *@

<div class="container mt-4 d-flex justify-content-center">
    <form method="get" asp-controller="Home" asp-action="Index" style="z-index: 3; width: 100%; max-width: 400px;">
        <div class="mb-3">
            <select class="form-select" name="categoriaId" onchange="this.form.submit()">
                <option value="">Todas as categorias</option>
                @foreach (var categoria in categorias)
                {
                    var isSelected = categoria.Id == categoriaSelecionada;
                    <option value="@categoria.Id" selected="@(isSelected ? "selected" : null)">
                        @categoria.Nome
                    </option>
                }
            </select>
        </div>
    </form>
</div>



<div class="container mt-5">
    <div class="d-flex flex-wrap gap-3 justify-content-center">
        @foreach (var produto in Model)
        {
            <div class="card" style="width: 18rem;">
                <img src="@produto.ArquivoFoto" class="card-img-top" alt="@produto.Nome">
                <div class="card-body">
                    <h5 class=""btn dark mt-3 card-title font-bold">@produto.Nome</h5>
                    <p class="card-text">R$ @produto.ValorVenda.ToString("F2")</p>
                    <a asp-controller="Home" asp-action="Produto" asp-route-id="@produto.Id" class="btn btn-primary">Ver
                        mais</a>
                </div>
            </div>
        }
    </div>
</div>
